<?xml version="1.0"?>
<sdf version="1.9">
  <world name="lab06_grid">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>.9 .9 .9 1</diffuse><direction>-.3 .2 -.9</direction>
    </light>

    <!-- Cell (row, column) has its Gazebo centre at (1 + column, 1 + row).
         simulation.launch.py spawns at (1, 1); /odom starts at (0, 0). -->
    <model name="arena"><static>true</static><link name="floor">
      <collision name="ground"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      <visual name="ground"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        <material><diffuse>.78 .82 .84 1</diffuse></material>
      </visual>
+      <visual name="grid_col_0"><pose>0.5 3.5 .003 0 0 0</pose><geometry><box><size>.012 6 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="grid_row_0"><pose>3.5 0.5 .003 0 0 0</pose><geometry><box><size>6 .012 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="grid_col_1"><pose>1.5 3.5 .003 0 0 0</pose><geometry><box><size>.012 6 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="grid_row_1"><pose>3.5 1.5 .003 0 0 0</pose><geometry><box><size>6 .012 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="grid_col_2"><pose>2.5 3.5 .003 0 0 0</pose><geometry><box><size>.012 6 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="grid_row_2"><pose>3.5 2.5 .003 0 0 0</pose><geometry><box><size>6 .012 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="grid_col_3"><pose>3.5 3.5 .003 0 0 0</pose><geometry><box><size>.012 6 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="grid_row_3"><pose>3.5 3.5 .003 0 0 0</pose><geometry><box><size>6 .012 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="grid_col_4"><pose>4.5 3.5 .003 0 0 0</pose><geometry><box><size>.012 6 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="grid_row_4"><pose>3.5 4.5 .003 0 0 0</pose><geometry><box><size>6 .012 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="grid_col_5"><pose>5.5 3.5 .003 0 0 0</pose><geometry><box><size>.012 6 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="grid_row_5"><pose>3.5 5.5 .003 0 0 0</pose><geometry><box><size>6 .012 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="grid_col_6"><pose>6.5 3.5 .003 0 0 0</pose><geometry><box><size>.012 6 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="grid_row_6"><pose>3.5 6.5 .003 0 0 0</pose><geometry><box><size>6 .012 .002</size></box></geometry><material><diffuse>.35 .44 .48 1</diffuse></material></visual>
      <visual name="start"><pose>1 1 .006 0 0 0</pose><geometry><box><size>.82 .82 .004</size></box></geometry><material><diffuse>.28 .56 .81 1</diffuse></material></visual>
      <visual name="goal"><pose>6 6 .006 0 0 0</pose><geometry><box><size>.82 .82 .004</size></box></geometry><material><diffuse>.27 .73 .45 1</diffuse></material></visual>
    </link></model>

    <!-- The divider fills column 3, rows 1 through 4, exactly as in GridRobot. -->
    <model name="walls"><static>true</static><link name="walls">
+      <collision name="divider"><pose>4 3.5 .25 0 0 0</pose><geometry><box><size>1 4 .5</size></box></geometry></collision>
      <visual name="divider"><pose>4 3.5 .25 0 0 0</pose><geometry><box><size>1 4 .5</size></box></geometry><material><diffuse>.23 .30 .36 1</diffuse></material></visual>
      <collision name="west"><pose>0.5 3.5 .15 0 0 0</pose><geometry><box><size>.08 6 .3</size></box></geometry></collision>
      <visual name="west"><pose>0.5 3.5 .15 0 0 0</pose><geometry><box><size>.08 6 .3</size></box></geometry><material><diffuse>.45 .52 .57 1</diffuse></material></visual>
      <collision name="east"><pose>6.5 3.5 .15 0 0 0</pose><geometry><box><size>.08 6 .3</size></box></geometry></collision>
      <visual name="east"><pose>6.5 3.5 .15 0 0 0</pose><geometry><box><size>.08 6 .3</size></box></geometry><material><diffuse>.45 .52 .57 1</diffuse></material></visual>
      <collision name="south"><pose>3.5 0.5 .15 0 0 0</pose><geometry><box><size>6 .08 .3</size></box></geometry></collision>
      <visual name="south"><pose>3.5 0.5 .15 0 0 0</pose><geometry><box><size>6 .08 .3</size></box></geometry><material><diffuse>.45 .52 .57 1</diffuse></material></visual>
      <collision name="north"><pose>3.5 6.5 .15 0 0 0</pose><geometry><box><size>6 .08 .3</size></box></geometry></collision>
      <visual name="north"><pose>3.5 6.5 .15 0 0 0</pose><geometry><box><size>6 .08 .3</size></box></geometry><material><diffuse>.45 .52 .57 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
