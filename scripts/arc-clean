#!/usr/bin/env bash
# arc-clean - stop every process a course launch starts.
#
# `pkill -f "gz sim"` is NOT enough and is the cause of a confusing class of
# failure. A launch starts several SEPARATE processes:
#
#   gazebo (ruby wrapper)     <- killed by pkill -f "gz sim"
#   robot_state_publisher     <- survives
#   parameter_bridge          <- survives
#   controller spawners       <- survive
#
# The survivors keep publishing. A second launch then adds its own, so /scan and
# /imu arrive twice and `ros2 topic info` reports two publishers. The rate looks
# exactly doubled and nothing in the launch output hints at why.
#
#     arc-clean          stop everything
#     arc-clean --check  list what is still running, change nothing
set -uo pipefail

PATTERNS=(
  "gz sim"
  "gz-sim"
  "ruby /opt/ros"
  "robot_state_publisher"
  "parameter_bridge"
  "ros_gz_bridge"
  "controller_manager/spawner"
  "rviz2"
  "ros2 launch arc_"
  # Nodes launched FROM the course workspace. Killing the launch process does
  # not kill the nodes it spawned, and listing each one by name is a list that
  # goes stale the moment a lab adds a node. Matching the install path catches
  # every one of them, now and later.
  "arc_ws/install"
  "cmd_vel_relay"
  "sensor_doctor"
  "drift_meter"
)

if [[ "${1:-}" == "--check" ]]; then
  found=0
  for p in "${PATTERNS[@]}"; do
    if pgrep -fa "$p" >/dev/null 2>&1; then
      pgrep -fa "$p"
      found=1
    fi
  done
  [[ $found -eq 0 ]] && echo "clean: no course processes running"
  [[ $found -eq 0 ]] && echo "(this checks PROCESSES; ros2 node list can lag behind)"
  exit $found
fi

for p in "${PATTERNS[@]}"; do pkill -f "$p" 2>/dev/null; done
sleep 2
# Anything that ignored SIGTERM gets SIGKILL. A wedged Gazebo occasionally does.
for p in "${PATTERNS[@]}"; do pkill -9 -f "$p" 2>/dev/null; done
sleep 1

# Restart the ROS 2 daemon before checking. The daemon caches the node graph,
# so a node that has already been killed can still appear in `ros2 node list`
# for some seconds afterwards. Without this the script reports a stale node it
# has in fact removed, and the smoke test then refuses to run for no reason.
ros2 daemon stop >/dev/null 2>&1
sleep 1

remaining=$(ros2 node list 2>/dev/null | grep -v "^$" | wc -l)
if [[ "$remaining" -gt 0 ]]; then
  echo "warning: $remaining ROS node(s) still visible:"
  ros2 node list 2>/dev/null
  echo "If these persist, they belong to another terminal or another domain."
else
  echo "clean: no course processes and no ROS nodes remaining"
fi
