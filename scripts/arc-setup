#!/usr/bin/env bash
# arc-setup - clone or update the course workspace, build it, and verify it.
#
# Safe to run repeatedly. On a fresh machine it clones; afterwards it pulls.
# Nothing here is destructive except --clean, which only removes build output.
#
#     arc-setup                 clone or pull, build, install, test
#     arc-setup --clean         wipe build/install/log first (use when builds act strange)
#     arc-setup --no-test       build only, skip the verification
#     arc-setup --repo URL      clone from somewhere other than the default
#
# Steps it performs, in order:
#   1. clone or pull the repository
#   2. repair executable bits lost through Windows
#   3. create the course working directories
#   4. resolve dependencies with rosdep
#   5. colcon build
#   6. install course-check, course-smoke-test and arc-clean system wide
#   7. run the offline test suite
#   8. run course-check and course-smoke-test
set -uo pipefail

# ----- configuration --------------------------------------------------------
REPO="${ARC_REPO:-https://github.com/farahaymen/AI-Planning-for-Robotics-Systems-2026-27.git}"
WS="$HOME/arc_ws"
SRC="$WS/src/arc-course"

CLEAN=0
RUN_TESTS=1
while [[ $# -gt 0 ]]; do
  case "$1" in
    --clean)   CLEAN=1; shift ;;
    --no-test) RUN_TESTS=0; shift ;;
    --repo)    REPO="$2"; shift 2 ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) echo "unknown option: $1"; exit 2 ;;
  esac
done

ok=$'\033[32m'; warn=$'\033[33m'; err=$'\033[31m'; off=$'\033[0m'
say()  { echo; echo "${ok}==>${off} $*"; }
note() { echo "    $*"; }
die()  { echo "${err}FAILED:${off} $*" >&2; exit 1; }

# ----- 0. stop anything still running ---------------------------------------
# A previous launch left running will make the verification steps measure the
# wrong thing, and an old gazebo holding the world file can also break a build.
say "stopping anything from a previous session"
if command -v arc-clean >/dev/null 2>&1; then
  arc-clean >/dev/null 2>&1 || true
else
  for p in "gz sim" "ruby /opt/ros" robot_state_publisher parameter_bridge \
           cmd_vel_relay rviz2 "arc_ws/install"; do
    pkill -f "$p" 2>/dev/null
  done
  sleep 2
fi
note "done"

# ----- 1. ROS must be sourced ----------------------------------------------
if [[ -z "${ROS_DISTRO:-}" ]]; then
  if [[ -f /opt/ros/jazzy/setup.bash ]]; then
    set +u; source /opt/ros/jazzy/setup.bash; set -u
    note "sourced /opt/ros/jazzy/setup.bash"
  else
    die "ROS 2 Jazzy not found at /opt/ros/jazzy. Run the provisioning stages first."
  fi
fi

# ----- 2. clone or pull -----------------------------------------------------
if [[ -d "$SRC/.git" ]]; then
  say "updating the repository"
  git -C "$SRC" pull --ff-only || die "pull failed. Commit or stash local changes first."
else
  say "cloning the repository"
  [[ "$REPO" == *YOUR-ORG* ]] && die "set your repository URL: arc-setup --repo https://github.com/farahaymen/AI-Planning-for-Robotics-Systems-2026-27.git"
  mkdir -p "$WS/src"
  git clone "$REPO" "$SRC" || die "clone failed. Is the repository public, or do you need a token?"
fi
note "$(git -C "$SRC" log --oneline -1)"

# ----- 3. repair executable bits -------------------------------------------
# Git stores the executable bit as file mode. A script authored on Windows is
# committed as 100644, and colcon's --symlink-install then links to a
# non-executable file. `ros2 launch` only considers executable files in libexec
# and reports a non-executable one as "not found", which is a confusing hour.
say "repairing executable bits"
FIXED=0
while IFS= read -r -d '' f; do
  if [[ ! -x "$f" ]]; then chmod +x "$f"; FIXED=$((FIXED+1)); fi
done < <(find "$SRC/scripts" "$SRC"/*/scripts -maxdepth 1 -type f -print0 2>/dev/null)
note "$FIXED file(s) needed it"

# Windows line endings break the shebang with "bad interpreter: ^M".
if command -v dos2unix >/dev/null 2>&1; then
  find "$SRC/scripts" "$SRC"/*/scripts -maxdepth 1 -type f -print0 2>/dev/null \
    | xargs -0 -r dos2unix -q 2>/dev/null
  note "line endings normalised"
else
  note "dos2unix not installed; skipping line-ending check"
fi

# ----- 4. course directories ------------------------------------------------
say "creating course directories"
mkdir -p "$WS"/{maps,bags,results,.arc}
note "maps bags results .arc"

# ----- 5. dependencies ------------------------------------------------------
say "resolving dependencies"
if command -v rosdep >/dev/null 2>&1; then
  rosdep install --from-paths "$WS/src" --ignore-src -y --rosdistro "$ROS_DISTRO" \
    2>&1 | tail -3 || note "${warn}rosdep reported problems; continuing${off}"
else
  note "rosdep not installed; skipping"
fi

# ----- 6. build -------------------------------------------------------------
if [[ $CLEAN -eq 1 ]]; then
  say "removing previous build output"
  rm -rf "$WS/build" "$WS/install" "$WS/log"
fi

say "building"
cd "$WS" || die "cannot enter $WS"
# Drop any stale overlay entries from an earlier session, otherwise colcon
# warns about install paths that no longer exist.
export AMENT_PREFIX_PATH="$(echo "${AMENT_PREFIX_PATH:-}" | tr ':' '\n' | grep -v "$WS/install" | paste -sd: -)"
export CMAKE_PREFIX_PATH="$(echo "${CMAKE_PREFIX_PATH:-}" | tr ':' '\n' | grep -v "$WS/install" | paste -sd: -)"
colcon build --symlink-install || die "build failed. Read the error above; it names the package."
# set -u must be off here: colcon's generated setup.bash reads COLCON_TRACE
# without a default, which is fatal under nounset and kills the script right
# after a successful build.
set +u; source "$WS/install/setup.bash"; set -u
note "$(ls "$WS/install" | grep -c '^arc_') arc packages installed"

# ----- 7. install the course commands --------------------------------------
say "installing course commands"
for tool in course-check course-smoke-test arc-clean arc-setup; do
  if [[ -f "$SRC/scripts/$tool" ]]; then
    sudo install -m 0755 "$SRC/scripts/$tool" "/usr/local/bin/$tool" \
      && note "$tool"
  fi
done

# ----- 8. verify ------------------------------------------------------------
if [[ $RUN_TESTS -eq 0 ]]; then
  say "build complete, verification skipped"
  echo "    run it yourself with: course-check && course-smoke-test --headless"
  exit 0
fi

say "offline test suite"
cd "$SRC" || die "cannot enter $SRC"
python3 -m pytest starters arc_eval -q 2>&1 | tail -3

say "environment check"
course-check || die "course-check failed. Note the incident ID above."

say "behavioural smoke test"
course-smoke-test --headless
RESULT=$?

echo
if [[ $RESULT -eq 0 ]]; then
  echo "${ok}Environment ready.${off}"
  echo
  echo "  Start the simulation:"
  echo "    ros2 launch arc_gazebo simulation.launch.py headless:=true"
  echo
  echo "  Visualise it, in a second terminal:"
  echo "    rviz2 -d \$(ros2 pkg prefix arc_gazebo)/share/arc_gazebo/rviz/simulation.rviz"
  echo
  echo "  Drive it, in a third:"
  echo "    ros2 run teleop_twist_keyboard teleop_twist_keyboard --ros-args -p use_sim_time:=true"
  echo
  echo "  Stop everything:"
  echo "    arc-clean"
else
  echo "${err}The smoke test found problems. The environment is NOT ready.${off}"
  echo "Launch output from the failed run: ~/arc_ws/.arc/last-launch.log"
fi
exit $RESULT
