<?xml version="1.0"?>
<!--
  ARC reference robot. Every parameter below is a course constant declared in
  docs/00_design_baseline.md section 5. If you change one here you must change it
  in arc_rl/nav_core.py RobotSpec and in the Nav2 costmap footprint, otherwise the
  planner will be reasoning about a robot that does not exist.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arc_bot">

  <!-- Deliberate faults, used by the laboratory exercises. Default is a healthy
       robot; the launch files pass these when a fault scenario is requested.
         fault=a  LiDAR update rate reduced to 3 Hz        (Lab 3)
         fault=b  LiDAR gz_frame_id names a link that does not exist (Lab 3)
         fault=c  LiDAR noise raised by two orders of magnitude       (Lab 3)
         tf_fault=parent  laser_joint parent is a non-existent link   (Lab 2) -->
  <xacro:arg name="fault" default="none"/>
  <xacro:arg name="tf_fault" default="none"/>
  <xacro:property name="fault" value="$(arg fault)"/>
  <xacro:property name="tf_fault" value="$(arg tf_fault)"/>

  <xacro:property name="wheel_radius"     value="0.050"/>
  <xacro:property name="wheel_separation" value="0.350"/>
  <xacro:property name="wheel_width"      value="0.035"/>
  <xacro:property name="base_length"      value="0.360"/>
  <xacro:property name="base_width"       value="0.300"/>
  <xacro:property name="base_height"      value="0.120"/>
  <xacro:property name="base_mass"        value="5.0"/>
  <xacro:property name="wheel_mass"       value="0.4"/>
  <xacro:property name="caster_radius"    value="0.025"/>
  <xacro:property name="lidar_height"     value="0.115"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}" izz="${m*(x*x+y*y)/12}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" iyy="${m*(3*r*r+h*h)/12}" izz="${m*r*r/2}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- base_footprint is the frame Nav2 and the TF tree are anchored to. It sits
       on the ground plane directly below base_link. -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="arc_grey"><color rgba="0.35 0.38 0.42 1"/></material>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + base_height/2}"/>
  </joint>

  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="arc_black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <origin rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_separation/2} ${-base_height/2}"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.02" friction="0.001"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <link name="caster_link">
    <visual><geometry><sphere radius="${caster_radius}"/></geometry></visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${base_length/2 - 0.05} 0 ${-base_height/2 - wheel_radius + caster_radius}"/>
  </joint>

  <!-- Sensor frames. The laser frame_id must match the frame_id published in the
       LaserScan message or the costmap will silently receive nothing usable. -->
  <link name="laser_link">
    <visual><geometry><cylinder radius="0.035" length="0.04"/></geometry></visual>
    <!-- NO collision element, deliberately. The LiDAR sensor origin sits at the
         centre of this link, so a collision cylinder here is geometry the sensor
         is standing inside: every ray hits it immediately and the whole scan
         returns the configured minimum range, 0.12 m, in all 360 directions.
         In RViz that appears as a tight red ring locked around the robot no
         matter where it drives.
         A sensor mount needs a visual so you can see it and an inertial so the
         solver is happy. It does not need collision. -->
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <xacro:unless value="${tf_fault == 'parent'}">
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser_link"/>
      <origin xyz="0.10 0 ${base_height/2 + 0.06}"/>
    </joint>
  </xacro:unless>
  <xacro:if value="${tf_fault == 'parent'}">
    <!-- chassis_link does not exist. The result is two disconnected trees,
         which view_frames shows immediately and tf2_echo reports as a missing
         frame. Lab 2, Exercise 2.3. -->
    <joint name="laser_joint" type="fixed">
      <parent link="chassis_link"/>
      <child link="laser_link"/>
      <origin xyz="0.10 0 ${base_height/2 + 0.06}"/>
    </joint>
  </xacro:if>

  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.02"/>
  </joint>

  <xacro:include filename="$(find arc_description)/urdf/arc_bot.ros2_control.xacro"/>
  <xacro:include filename="$(find arc_description)/urdf/arc_bot.gazebo.xacro"/>

</robot>
